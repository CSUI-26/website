---
// note: maybe used for a common UI component in the future
import type { HTMLAttributes } from "astro/types";
import styles from "./Pill.module.css";

export type PillVariant = "filter" | "tag" | "badge" | "solid";
export type PillTheme = "cs" | "si" | "kki" | "ai";

interface Props extends HTMLAttributes<"a"> {
	as?: "span" | "button" | "div" | "a";
	variant?: PillVariant;
	theme?: PillTheme | undefined | null;
	active?: boolean;
	class?: string | undefined | null;
	href?: string | undefined | null;
	type?: "button" | "submit" | "reset" | undefined;
}

const {
	as: Tag = Astro.props.href ? "a" : "span",
	variant = "tag",
	theme,
	active = false,
	class: className = "",
	...rest
} = Astro.props;

const variantClass = styles[`pill__${variant}`];
const themeClass = theme ? styles[`pill__theme_${theme}`] : "";
const activeClass = active ? styles.pill__active : "";
---

<Tag
	class:list={[styles.pill, variantClass, themeClass, activeClass, className]}
	{...rest}
>
	<slot />
</Tag>
