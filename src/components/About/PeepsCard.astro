---
import Styles from "./PeepsCard.module.css";
import { GraduationCap } from "@lucide/astro";
---

<div class={Styles.peeps_card}>
	<div class={Styles.prodi_container}>
		<div class={`${Styles.prodi_card} ${Styles.red}`}>
			<GraduationCap size={128} />
			<div class={Styles.prodi_card_count}>
				<div class={Styles.prodi_card_count_num}>67</div>
				<div class={Styles.prodi_card_count_sub}>students</div>
			</div>
			<div class={Styles.prodi_name}>Computer Science</div>
		</div>
		<div class={`${Styles.prodi_card} ${Styles.red}`}>
			<GraduationCap size={128} />
			<div class={Styles.prodi_card_count}>
				<div class={Styles.prodi_card_count_num}>67</div>
				<div class={Styles.prodi_card_count_sub}>students</div>
			</div>
			<div class={Styles.prodi_name}>Information Systems</div>
		</div>
		<div class={`${Styles.prodi_card} ${Styles.blue}`}>
			<GraduationCap size={128} />
			<div class={Styles.prodi_card_count}>
				<div class={Styles.prodi_card_count_num}>67</div>
				<div class={Styles.prodi_card_count_sub}>students</div>
			</div>
			<div class={Styles.prodi_name}>Artificial Intelligence</div>
		</div>
		<div class={`${Styles.prodi_card} ${Styles.blue}`}>
			<GraduationCap size={128} />
			<div class={Styles.prodi_card_count}>
				<div class={Styles.prodi_card_count_num}>67</div>
				<div class={Styles.prodi_card_count_sub}>students</div>
			</div>
			<div class={Styles.prodi_name}>Computer Science KKI</div>
		</div>
	</div>
	<div class={Styles.cta}>
		<div class={Styles.tagline}>
			Different minds, one community.<br />Get to know the people behind
			our stories.
		</div>
		<a href="/members" class={Styles.members_btn}>Meet our members</a>
	</div>
</div>
