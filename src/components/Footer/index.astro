---
import styles from "./index.module.css";
import { RootRoutes} from "@/routes";
import { Strings } from "@/strings";

// Icons
import InstagramIcon from "@/icons/instagram.svg";
import GmailLogo from "@/icons/gmail.svg"
import Xlogo from '@/icons/X.svg'
import YoutubeIcon from "@/icons/youtube.svg"


---

<footer class={styles.footer}>


	<div class={styles.logo}>
		<div class={styles.footer_title}>
			
			<a
				data-text={Strings.FleetingCode}
				href={RootRoutes.get("Home")}
				class={styles.footer_title_text}
			>
				{Strings.FleetingCode}
			</a>
		</div> 
		<p class={styles.copyright_text}>
			©2026 CSUI 26. All rights reserved.
		</p>
	</div>
	<div class={styles.more}>
		<div class={styles.mininavbar}>
			<ul class={styles.footer_links}>
				{
					Array.from(RootRoutes).map(([title, path]) => (
						<li
							title={title}
							class={styles.footer_links_items}
						>
							<a href={path}>{title}</a>
						</li>
					))
				}
			</ul>
		</div>
	<div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center;">
  <GmailLogo style="width: clamp(28px, 6vw, 49.3px); height: clamp(30px, 6.5vw, 53.05px); margin: clamp(4px, 1.5vw, 10px);" />
  <Xlogo style="width: clamp(28px, 6vw, 49.3px); height: clamp(30px, 6.5vw, 53.05px); margin: clamp(4px, 1.5vw, 10px);" />
  <InstagramIcon style="width: clamp(28px, 6vw, 49.3px); height: clamp(30px, 6.5vw, 53.05px); margin: clamp(4px, 1.5vw, 10px);" />
  <YoutubeIcon style="width: clamp(28px, 6vw, 49.3px); height: clamp(30px, 6.5vw, 53.05px); margin: clamp(4px, 1.5vw, 10px);" />
</div>
	</div>
	<!-- <ul class={styles.footer_links}>
		{
			Array.from(RootRoutes).map(([title, path]) => (
				<li
					title={title}
					class={`${styles.footer_links_items} ${activeTab === path ? styles.footer_links_items__active : ""}`}
				>
					<a href={path}>{title.toLowerCase()}</a>
				</li>
			))
		}
	</ul>-->
