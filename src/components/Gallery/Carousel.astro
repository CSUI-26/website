---
import { Image } from "astro:assets";

interface Props {
  slides: ImageMetadata[];
  alts?: string[];
  interval?: number; // autoplay delay in ms
  aspectRatio?: string | number; // e.g. "16 / 9", "1", 1.5
}

const { slides, alts = [], interval = 5000, aspectRatio = "4 / 3"} = Astro.props;
---

<div class="carousel" data-carousel data-interval={interval} style={`--carousel-ratio: ${aspectRatio}`}>
  <div class="track" data-track>
    {slides.map((src, i) => (
      <Image
        src={src}
        alt={alts[i] ?? `Slide ${i + 1}`}
        class="heroImg"
        loading={i === 0 ? "eager" : "lazy"}
      />
    ))}
  </div>

  {slides.length > 1 && (
    <>
      <button class="nav prev" data-prev aria-label="Previous slide">&#10094;</button>
      <button class="nav next" data-next aria-label="Next slide">&#10095;</button>

      <div class="dots">
        {slides.map((_, i) => (
          <button
            class="dot"
            data-dot
            data-active={i === 0 ? "" : undefined}
            aria-label={`Go to slide ${i + 1}`}
          />
        ))}
      </div>
    </>
  )}
</div>

<style>
  @media (min-width: 0px) {
    .nav {
      display: none;
    }
  }

  @media (min-width: 580px) {
    .nav {
      display:block;
    }
  }

  .carousel {
    position: relative;
    aspect-ratio: var(--carousel-ratio, 4 / 3);
    overflow: hidden;
    border-radius: 20px;
  }

  .track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }

  /* :global so the rule reliably hits the <img> rendered by <Image> */
  .track :global(.heroImg) {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scroll-snap-align: center;
  }

  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
  }
  .prev { left: 0.5rem; }
  .next { right: 0.5rem; }

  .dots {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.5);
    cursor: pointer;
  }
  .dot[data-active] {
    background: #fff;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const dots = [...root.querySelectorAll<HTMLElement>("[data-dot]")];
    const count = track.children.length;
    const delay = Number(root.dataset.interval) || 5000;
    let index = 0;
    let timer: number | undefined;

    const go = (n: number) => {
      index = (n + count) % count;
      track.scrollTo({ left: index * track.clientWidth, behavior: "smooth" });
    };

    const stop = () => {
      clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop(); // avoid stacking multiple intervals
      if (count < 2) return;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      timer = window.setInterval(() => go(index + 1), delay);
    };

    // keep dots in sync with manual swipes/scrolls
    track.addEventListener(
      "scroll",
      () => {
        index = Math.round(track.scrollLeft / track.clientWidth);
        dots.forEach((d, i) => d.toggleAttribute("data-active", i === index));
      },
      { passive: true }
    );

    dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
    root.querySelector("[data-prev]")?.addEventListener("click", () => go(index - 1));
    root.querySelector("[data-next]")?.addEventListener("click", () => go(index + 1));

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);
    start();
  });
</script>