---
import "@styles/global.css";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Splashscreen from "@/components/splashscreen/index.astro";
import type { RootRoutesValues } from "@/routes";
import { Font } from "astro:assets";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
	title: string;
	activeTab?: RootRoutesValues;
}

const { title, activeTab } = Astro.props;
---

<SpeedInsights />
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<Font cssVariable="--fontface-inter" preload />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{/* Black so the browser paints its own chrome to match the footer. */}
		<meta name="theme-color" content="#000000" />
		{/* The site has no light theme; claim dark only so browser UI such as
		    scrollbars and the Android navigation bar render dark too. */}
		<meta name="color-scheme" content="dark" />
	</head>
	<body>
		<Splashscreen />

		<Header activeTab={activeTab} />

		<main style="flex-grow: 1;">
			<slot />
		</main>

		<Footer activeTab={activeTab} />
	</body>
</html>