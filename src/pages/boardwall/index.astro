---
import "@styles/global.css";
import BaseLayout from "@layouts/BaseLayout.astro";
import { Strings } from "@/strings";

const title = `${Strings.SlugTitles.Boardwall} - ${Strings.SiteTitle}`;
---

<BaseLayout title={title} activeTab="/members">
	<main style="padding: 4rem 1.5rem; text-align: center; max-width: 800px; margin: 0 auto;">
		<h1 style="font-size: 2.5rem; margin-bottom: 1rem; color: #fff;">{Strings.SlugTitles.Boardwall}</h1>
		<p style="color: rgba(255, 255, 255, 0.7); font-size: 1.125rem;">Coming soon...</p>
	</main>
</BaseLayout>
