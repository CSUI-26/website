---
import "@styles/global.css";
import BaseLayout from "@layouts/BaseLayout.astro";
import ImageRibbon from "@/components/Gallery/ImageRibbon.astro";
import { Strings } from "@/strings";
import { RootRoutes } from "@/routes";
import { Image } from "astro:assets";
import styles from "./index.module.css";
import Hero from "@images/hero.png";
import Racoon1 from "@images/Racoon1.png";
import Racoon2 from "@images/Racoon2.png"

const modules = import.meta.glob<{ default: ImageMetadata }>(
	"@images/gallery/*.{jpg,jpeg,png,webp,avif}",
	{ eager: true }
);

const title = `${Strings.SlugTitles.Gallery} - ${Strings.SiteTitle}`;
const slides = Object.entries(modules)
	.sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
	.map(([, mod]) => mod.default);
---

<BaseLayout title={title} activeTab={RootRoutes.get("Gallery")!}>
	<main class={styles.main}>
		<section class={styles.hero}>
			<div class={styles.top}>
				<h1 class={styles.title}>Capturing moment,</h1>
				<h1 class={styles.title}>Sharing stories</h1>
			</div>

			<div class={styles.bottom}>
				<div class={styles.left}>
					<p class={styles.heroP}>
						Lorem ipsum dolor sit amet consectetur, adipisicing elit.
						Architecto, consequuntur tempore eligendi aut odit sint est
						odio, eaque cumque dicta reiciendis illo repellendus veritatis
						unde quisquam, libero assumenda tempora aspernatur.
					</p>
				</div>

				<div class={styles.right}>
					<div class={styles.carousel} data-carousel>
						<div class={styles.track} data-track>
							{slides.map((src, i) => (
								<Image src={src} alt="" class={styles.heroImg} loading={i === 0 ? "eager" : "lazy"}/>
							))}
						</div>

						<button class={`${styles.nav} ${styles.prev}`} data-prev aria-label="Previous slide">&#10094;</button>
						<button class={`${styles.nav} ${styles.next}`} data-next aria-label="Next slide">&#10095;</button>

						<div class={styles.dots}>
							{slides.map((_, i) => (
								<button class={styles.dot} data-dot data-active={i === 0 ? "" : undefined} aria-label={`Go to slide ${i + 1}`}/>
							))}
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<div class={styles.darkbg}>
		<ImageRibbon images={slides} speed={40} height={180} />
	</div>
</BaseLayout>

<script>
	document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
		const track = root.querySelector<HTMLElement>("[data-track]")!;
		const dots = [...root.querySelectorAll<HTMLElement>("[data-dot]")];
		const count = track.children.length;
		let index = 0;
		let timer: number | undefined;

		const go = (n: number) => {
			index = (n + count) % count;
			track.scrollTo({ left: index * track.clientWidth, behavior: "smooth" });
		};

		const start = () => {
			if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			timer = window.setInterval(() => go(index + 1), 5000);
		};
		const stop = () => clearInterval(timer);

		// keep dots in sync with manual swipes/scrolls
		track.addEventListener(
			"scroll",
			() => {
				index = Math.round(track.scrollLeft / track.clientWidth);
				dots.forEach((d, i) => d.toggleAttribute("data-active", i === index));
			},
			{ passive: true }
		);

		dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
		root.querySelector("[data-prev]")?.addEventListener("click", () => go(index - 1));
		root.querySelector("[data-next]")?.addEventListener("click", () => go(index + 1));

		root.addEventListener("mouseenter", stop);
		root.addEventListener("mouseleave", start);
		start();
	});
</script>
