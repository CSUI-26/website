---
import Styles from "./index.module.css";
import BaseLayout from "@layouts/BaseLayout.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { Strings } from "@/strings";
import { RootRoutes } from "@/routes";
import { Image } from "astro:assets";
import Hero from "@images/hero.png";
import Racoon1 from "@images/Racoon1.png";
// import Racoon2 from "@images/Racoon2.png"
import Highlight1 from "@images/about/highlight1.png";
import Heading from "@components/Heading.astro";
import {
	SiGmail,
	SiInstagram,
	SiX,
	SiYoutube,
} from "@icons-pack/react-simple-icons";
import { Picture } from "astro:assets";
import HighlightCarousel from "@components/About/HighlightCarousel.astro";
import ActivitiesCarousel from "@components/About/ActivitiesCarousel.astro";
import ActivitiesCard from "@components/About/ActivitiesCard.astro";

const title = `${Strings.SlugTitles.About} - ${Strings.SiteTitle}`;
---

<BaseLayout title={title} activeTab={RootRoutes.get("Home")!}>
	<TableOfContents />
	<section class={`${Styles.section} ${Styles.section_hero}`}>
		<h1 class={Styles.h1}>{Strings.SiteTitle.toUpperCase()}</h1>
		<Image
			class={Styles.hero_img}
			src={Hero}
			alt=""
			layout="constrained"
			priority
			class={Styles.hero_img}
			draggable={false}
		/>
		<div class={Styles.text_columns}>
			<p>
				Lorem ipsum dolor sit amet consectetur, adipisicing elit.
				Architecto, consequuntur tempore eligendi aut odit sint est
				odio, eaque cumque dicta reiciendis illo repellendus veritatis
				unde quisquam, libero assumenda tempora aspernatur.
			</p>
			<p>
				Lorem ipsum dolor sit amet consectetur adipisicing elit. Illo
				quisquam perferendis laborum temporibus explicabo rem quis fuga
				ea sint repudiandae, enim vel dignissimos, quos reiciendis
				aliquid quibusdam inventore consequuntur porro?
			</p>
		</div>
	</section>

	<section class={`${Styles.section} ${Styles.section_greetings}`}>
		<div class={Styles.section_contents}>
			<Picture
				class=`${Styles.greetings_image} ${Styles.image}`
				src={Racoon1}
				width={400}
				alt="Photo of Zenith"
				layout="constrained"
				loading={"lazy"}
				decoding={"async"}
			/>
			<div class={Styles.greetings_content}>
				<Heading level={2} class={Styles.subheadings}>Greetings</Heading
				>
				<p>
					Lorem ipsum dolor sit amet consectetur adipisicing elit.
					Explicabo nemo molestias cum nesciunt minima, tempore
					doloremque porro adipisci. Officiis aut aliquam in ratione
					maxime, alias dolorem beatae consectetur cumque ducimus?
					Magnam saepe incidunt quia suscipit perspiciatis ipsam
					doloribus aliquid maiores. Cum, cumque expedita ipsum
					commodi voluptatum culpa tempore quis laudantium doloremque
					sit, deleniti eligendi earum ullam aspernatur laboriosam ab.
					Quia. Fuga corrupti quas labore debitis aut veniam, libero,
					laborum, autem assumenda neque consequuntur exercitationem
					error mollitia commodi delectus ratione! Amet reprehenderit
					corrupti quasi consequuntur optio ullam incidunt at harum
					alias?
				</p>
				<div class={Styles.icon_set}>
					<SiGmail size={50} />
					<SiX size={50} />
					<SiInstagram size={50} />
					<SiYoutube size={50} />
				</div>
			</div>
		</div>
	</section>

	<section class={`${Styles.section} ${Styles.section_highlight}`}>
		<div class={Styles.section_contents}>
			<Heading level={2} class={Styles.subheadings}>Our Highlight</Heading
			>
			<p class={Styles.highlight_content}>
				Lorem ipsum, dolor sit amet consectetur adipisicing elit.
				Sapiente eveniet doloribus, dolore exercitationem dicta iure
				labore placeat repudiandae dolorum ea eos mollitia sunt velit
				eaque distinctio iste, saepe necessitatibus nostrum.
			</p>
			<HighlightCarousel />
		</div>
	</section>

	<section class={`${Styles.section} ${Styles.section_activities}`}>
		<div class={Styles.section_contents}>
			<Heading level={2} class={Styles.subheadings}
				>Our Activities</Heading
			>
			<p>
				Lorem ipsum dolor sit amet consectetur adipisicing elit.
				Corrupti nesciunt soluta voluptate dolor ad eveniet quis qui
				perspiciatis explicabo error consequatur quaerat molestiae nihil
				blanditiis obcaecati odit totam, inventore rerum!
			</p>
		</div>
		<ActivitiesCarousel>
			<ActivitiesCard
				picture={Highlight1}
				activityTitle="DDP0"
				date="12 Mei 2026"
				description="Lorem ipsum dolor sit amet consectetur adipisicing elit. In beatae, molestiae, enim non id aperiam qui nam laudantium facere ea aliquid laborum! Odit quae repudiandae quod voluptate. Officiis, porro amet?"
			/>
			<ActivitiesCard
				picture={Highlight1}
				activityTitle="PKKMB"
				date="12 Mei 2026"
				description="Lorem ipsum dolor sit amet consectetur adipisicing elit. In beatae, molestiae, enim non id aperiam qui nam laudantium facere ea aliquid laborum! Odit quae repudiandae quod voluptate. Officiis, porro amet?"
			/>
			<ActivitiesCard
				picture={Highlight1}
				activityTitle="PSAF"
				date="12 Mei 2026"
				description="Lorem ipsum dolor sit amet consectetur adipisicing elit. In beatae, molestiae, enim non id aperiam qui nam laudantium facere ea aliquid laborum! Odit quae repudiandae quod voluptate. Officiis, porro amet?"
			/>
			<ActivitiesCard
				picture={Highlight1}
				activityTitle="PMB"
				date="12 Mei 2026"
				description="Lorem ipsum dolor sit amet consectetur adipisicing elit. In beatae, molestiae, enim non id aperiam qui nam laudantium facere ea aliquid laborum! Odit quae repudiandae quod voluptate. Officiis, porro amet?"
			/>
		</ActivitiesCarousel>
	</section>

	<section class={`${Styles.section} ${Styles.section_peeps}`}>
		<Heading level={2} class={Styles.subheadings}>Our Peeps</Heading>
		<p>
			<a href="/members">See our members!</a>
		</p>
	</section>
</BaseLayout>
