---
import ProdiDetailView from "@/components/Academic/ProdiDetailView";
import { type ProgramStudy, programStudies } from "@/data/academic";
import { RootRoutes } from "@/routes";
import { Strings } from "@/strings";
import BaseLayout from "@layouts/BaseLayout.astro";

export function getStaticPaths() {
	return programStudies.map((prodi) => ({
		params: { prodi: prodi.id },
		props: { prodi },
	}));
}

interface Props {
	prodi: ProgramStudy;
}

const { prodi } = Astro.props;
const title = `${prodi.name} - ${Strings.SlugTitles.Academic} - ${Strings.SiteTitle}`;
const activeTab = RootRoutes.get("Academic");
const otherProdis = programStudies.filter((p) => p.id !== prodi.id);
---

<BaseLayout title={title} {...(activeTab ? { activeTab } : {})}>
	<ProdiDetailView
		client:load
		prodiId={prodi.id}
		initialProdi={prodi}
		initialOtherProdis={otherProdis}
	/>
</BaseLayout>
