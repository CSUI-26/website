---
import { Image } from "astro:assets";
import AcademicView from "@/components/Academic/AcademicView";
import { programStudies } from "@/data/academic";
import { RootRoutes } from "@/routes";
import { Strings } from "@/strings";
import Racoon1 from "@images/Racoon1.png";
import Racoon2 from "@images/Racoon2.png";
import BaseLayout from "@layouts/BaseLayout.astro";
import Styles from "./index.module.css";

const title = `${Strings.SlugTitles.Academic} - ${Strings.SiteTitle}`;
const activeTab = RootRoutes.get("Academic");
---

<BaseLayout title={title} {...(activeTab ? { activeTab } : {})}>
	<AcademicView client:load initialPrograms={programStudies}>
		<div class={Styles.mascot_container} aria-hidden="true">
			<div class={Styles.mascot_wrapper_left}>
				<Image
					class={`${Styles.mascot} ${Styles.mascot_left}`}
					src={Racoon1}
					alt=""
					width={400}
					loading="eager"
					draggable={false}
				/>
			</div>
			<div class={Styles.mascot_wrapper_right}>
				<Image
					class={`${Styles.mascot} ${Styles.mascot_right}`}
					src={Racoon2}
					alt=""
					width={400}
					loading="eager"
					draggable={false}
				/>
			</div>
		</div>
	</AcademicView>
</BaseLayout>
