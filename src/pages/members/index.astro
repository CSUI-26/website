---
import BaseLayout from "@layouts/BaseLayout.astro";
import Surface from "@/components/member/Surface.astro";
import MembersDirectory from "@/components/member-list/MembersDirectory";
import { Strings } from "@/strings";
import { RootRoutes } from "@/routes";
import rawData from "@/data/members.json";
import type { Member } from "@/types/member";
import {
	getMajorCode,
	getMajorThemeKey,
	getMemberPhotoUrl,
	getMemberSlug,
} from "@/util";
import { parseMemberNiche } from "@/components/member-list/tags";
import styles from "./index.module.css";

const rawMembers = rawData as Member[];
const title = `${Strings.SlugTitles.Member} - ${Strings.SiteTitle}`;

// Pre-calculate photo URL, slug, major code, normalized tags, and socials on the server
// so the client-side React island does not require Node.js fs modules
const directoryMembers = rawMembers.map((member) => {
	const { allTags } = parseMemberNiche(member.niche);
	const instagram = member.instagram
		? `https://instagram.com/${member.instagram.replace(/^@/, "")}`
		: null;
	const linkedin =
		member.linkedin && member.linkedin.trim() !== "-"
			? member.linkedin.startsWith("http")
				? member.linkedin
				: `https://${member.linkedin}`
			: null;
	const github =
		member.github && member.github.trim() !== "-"
			? member.github.startsWith("http")
				? member.github
				: `https://github.com/${member.github}`
			: null;
	const line =
		member.line && member.line.trim() !== "-"
			? `https://line.me/ti/p/~${member.line}`
			: null;

	return {
		npm: member.npm,
		name: member.name,
		nama_panggilan: member.nama_panggilan,
		major: member.major,
		majorCode: getMajorCode(member.major),
		majorTheme: getMajorThemeKey(member.major),
		niche: member.niche || "",
		quote:
			member.quotes &&
			member.quotes.trim() !== "-" &&
			member.quotes.trim() !== "*"
				? member.quotes.trim()
				: "",
		tags: allTags,
		badge: allTags[0] || "Member",
		slug: getMemberSlug(member),
		photoUrl: getMemberPhotoUrl(member),
		socials: { instagram, linkedin, github, line },
	};
});
---

<BaseLayout title={title} activeTab={RootRoutes.get("Members")!}>
	<main class={styles.main}>
		<h1 class={styles.title}>our members</h1>

		<!-- Interactive Members Directory React Island -->
		<MembersDirectory client:load members={directoryMembers} />

		<!-- Floating BoardWall CTA -->
		<div class={styles.boardwall_cta_wrapper}>
			<Surface as="a" href="/boardwall" variant="button" class={styles.boardwall_cta}>
				<span>BoardWall</span>
			</Surface>
		</div>
	</main>
</BaseLayout>
