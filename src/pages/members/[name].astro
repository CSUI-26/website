---
import BaseLayout from "@layouts/BaseLayout.astro";
import rawData from "@/data.json";
import type { Member } from "@/types/member";
import {
	getMajorCode,
	getMemberPhotoUrl,
	getMemberSlug,
	getSimilarMembers,
} from "@/util";
import ArrowLeftIcon from "@/icons/arrow-left.svg";
import InstagramIcon from "@/icons/instagram.svg";
import LinkedinIcon from "@/icons/linkedin.svg";
import GithubIcon from "@/icons/github.svg";
import LineIcon from "@/icons/line.svg";
import { Globe } from "lucide-react";
import IconButton from "@/components/Members/IconButton.astro";
import Pill from "@/components/Members/Pill.astro";
import Surface from "@/components/Members/Surface.astro";
import PeerCarousel from "@/components/Members/PeerCarousel.astro";
import styles from "./[name].module.css";

export async function getStaticPaths() {
	const allMembers = rawData as Member[];
	return allMembers.map((member) => ({
		params: { name: getMemberSlug(member) },
		props: {
			member,
			similar: getSimilarMembers(member, allMembers, 14),
		},
	}));
}

export interface Props {
	member: Member;
	similar: Member[];
}

const { member, similar } = Astro.props;

const title = `${member.name} - Members - Zenith`;
const majorCode = getMajorCode(member.major);
const displayName = member.nama_panggilan || member.name;

const instagramUrl = member.instagram
	? `https://instagram.com/${member.instagram.replace(/^@/, "")}`
	: null;

const linkedinUrl =
	member.linkedin && member.linkedin.trim() !== "-"
		? member.linkedin.startsWith("http")
			? member.linkedin
			: `https://${member.linkedin}`
		: null;

const githubUrl =
	member.github && member.github.trim() !== "-"
		? member.github.startsWith("http")
			? member.github
			: `https://github.com/${member.github}`
		: null;

const lineUrl =
	member.line && member.line.trim() !== "-"
		? `https://line.me/ti/p/~${member.line}`
		: null;

const rawWebsite = (member as unknown as Record<string, unknown>).website as string | undefined;
const websiteUrl =
	rawWebsite && rawWebsite.trim() !== "" && rawWebsite.trim() !== "-"
		? rawWebsite.startsWith("http")
			? rawWebsite
			: `https://${rawWebsite}`
		: null;

const nicheTags = member.niche
	? member.niche
			.split(/[,/]/)
			.map((tag) => tag.trim())
			.filter(Boolean)
	: [];
---

<BaseLayout title={title} activeTab="/members">
	<main class={styles.container} data-profile-npm={member.npm}>
		<!-- Back Button -->
		<nav class={styles.back_nav} aria-label="Breadcrumb">
			<a href="/members" class={styles.back_button}>
				<ArrowLeftIcon width={20} height={20} />
				<span>Back to members</span>
			</a>
		</nav>

		<!-- Main Member Profile Card Section -->
		<section class={styles.card_section}>
			<!-- Left: Avatar Photo -->
			<div class={styles.photo_box}>
				<img
					src={getMemberPhotoUrl(member)}
					alt={member.name}
					class={styles.photo}
					data-field="photo"
					loading="eager"
					decoding="async"
				/>
			</div>

			<!-- Right: Member Details -->
			<Surface variant="card" class={styles.details_box}>
				<!-- Social Media Links -->
				<div class={styles.social_row}>
					{instagramUrl && (
						<IconButton
							href={instagramUrl}
							target="_blank"
							rel="noopener noreferrer"
							ariaLabel="Instagram"
						>
							<InstagramIcon width={22} height={22} />
						</IconButton>
					)}
					{linkedinUrl && (
						<IconButton
							href={linkedinUrl}
							target="_blank"
							rel="noopener noreferrer"
							ariaLabel="LinkedIn"
						>
							<LinkedinIcon width={22} height={22} />
						</IconButton>
					)}
					{githubUrl && (
						<IconButton
							href={githubUrl}
							target="_blank"
							rel="noopener noreferrer"
							ariaLabel="GitHub"
						>
							<GithubIcon width={22} height={22} />
						</IconButton>
					)}
					{lineUrl && (
						<IconButton
							href={lineUrl}
							target="_blank"
							rel="noopener noreferrer"
							ariaLabel="LINE"
						>
							<LineIcon width={22} height={22} />
						</IconButton>
					)}
					{websiteUrl && (
						<IconButton
							href={websiteUrl}
							target="_blank"
							rel="noopener noreferrer"
							ariaLabel="Website"
							data-social="website"
						>
							<Globe width={20} height={20} />
						</IconButton>
					)}
				</div>

				<!-- Name, Real Name, Email & Major Badge -->
				<div class={styles.header_group}>
					<div class={styles.header_row}>
						<h1 class={styles.name} data-field="display-name">{displayName}</h1>
						<Pill variant="solid">{majorCode}</Pill>
					</div>
					{member.name && member.nama_panggilan && member.nama_panggilan.trim().toLowerCase() !== member.name.trim().toLowerCase() && (
						<p class={styles.real_name} data-field="real-name">{member.name}</p>
					)}
					{member.email && (
						<a href={`mailto:${member.email}`} class={styles.email} data-field="email">
							{member.email}
						</a>
					)}
				</div>

				<!-- Bio / Description -->
				<p class={styles.bio} data-field="bio">
					{member.deskripsi || "No description provided."}
				</p>

				<!-- Niche Domain Tags -->
				{nicheTags.length > 0 && (
					<div class={styles.niche_tags}>
						{nicheTags.map((tag) => (
							<Pill variant="tag">{tag}</Pill>
						))}
					</div>
				)}
			</Surface>
		</section>

		<!-- Bottom: See Similar People Section -->
		{similar.length > 0 && <PeerCarousel similar={similar} />}
	</main>
</BaseLayout>

<script>
	import { doc, onSnapshot } from "firebase/firestore";
	import { db } from "@/lib/firebase";

	const container = document.querySelector<HTMLElement>("[data-profile-npm]");
	const npm = container?.dataset.profileNpm;

	if (npm) {
		const docRef = doc(db, "members", npm);
		onSnapshot(docRef, (docSnap) => {
			if (!docSnap.exists()) return;
			const data = docSnap.data();

			// Update Display Name & Real Name
			const displayNameEl = document.querySelector<HTMLElement>("[data-field='display-name']");
			const realNameEl = document.querySelector<HTMLElement>("[data-field='real-name']");
			if (displayNameEl) {
				displayNameEl.textContent = data.nama_panggilan || data.name || "";
			}
			if (realNameEl) {
				realNameEl.textContent = data.name || "";
			}

			// Update Email
			const emailEl = document.querySelector<HTMLAnchorElement>("[data-field='email']");
			if (emailEl && data.email) {
				emailEl.textContent = data.email;
				emailEl.href = `mailto:${data.email}`;
			}

			// Update Bio
			const bioEl = document.querySelector<HTMLElement>("[data-field='bio']");
			if (bioEl) {
				bioEl.textContent = data.deskripsi || "No description provided.";
			}

			// Update Photo
			const photoEl = document.querySelector<HTMLImageElement>("[data-field='photo']");
			if (photoEl && data.foto?.url) {
				photoEl.src = data.foto.url;
				if (data.foto.config) {
					photoEl.style.transform = `scale(${data.foto.config.zoom || 1})`;
					photoEl.style.objectPosition = `${data.foto.config.x || 50}% ${data.foto.config.y || 50}%`;
				}
			}

			// Update Website link
			const websiteBtn = document.querySelector<HTMLAnchorElement>("[data-social='website']");
			if (websiteBtn && data.website) {
				websiteBtn.href = data.website.startsWith("http") ? data.website : `https://${data.website}`;
			}
		});
	}
</script>
