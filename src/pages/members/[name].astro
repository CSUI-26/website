---
import BaseLayout from "@layouts/BaseLayout.astro";
import rawData from "@/data.json";
import type { Member } from "@/types/member";
import {
	getMajorCode,
	getMemberPhotoUrl,
	getMemberSlug,
	shuffle,
} from "@/util";
import ArrowLeftIcon from "@/icons/arrow-left.svg";
import ArrowRightIcon from "@/icons/arrow-right.svg";
import InstagramIcon from "@/icons/instagram.svg";
import LinkedinIcon from "@/icons/linkedin.svg";
import GithubIcon from "@/icons/github.svg";
import LineIcon from "@/icons/line.svg";
import styles from "./[name].module.css";

export async function getStaticPaths() {
	const allMembers = rawData as Member[];
	return allMembers.map((member) => {
		const sameMajor = allMembers.filter(
			(m) => m.npm !== member.npm && m.major === member.major,
		);
		const otherMajor = allMembers.filter(
			(m) => m.npm !== member.npm && m.major !== member.major,
		);

		// Shuffle candidates using Math.random()
		const shuffledSame = shuffle([...sameMajor]);
		const shuffledOther = shuffle([...otherMajor]);

		// Pick 10 peers from the same prodi and 4 from other prodi so current prodi stays dominant
		const dominantSame = shuffledSame.slice(0, 10);
		const mixedOther = shuffledOther.slice(0, 4);

		// Interleave / shuffle the combined 14 peers
		const similar = shuffle([...dominantSame, ...mixedOther]);

		return {
			params: { name: getMemberSlug(member) },
			props: { member, similar },
		};
	});
}

interface Props {
	member: Member;
	similar: Member[];
}

const { member, similar } = Astro.props;

const title = `${member.name} - Members - Zenith`;
const majorCode = getMajorCode(member.major);
const displayName = member.nama_panggilan || member.name;

const instagramUrl = member.instagram
	? `https://instagram.com/${member.instagram.replace(/^@/, "")}`
	: null;

const linkedinUrl =
	member.linkedin && member.linkedin.trim() !== "-"
		? member.linkedin.startsWith("http")
			? member.linkedin
			: `https://${member.linkedin}`
		: null;

const githubUrl =
	member.github && member.github.trim() !== "-"
		? member.github.startsWith("http")
			? member.github
			: `https://github.com/${member.github}`
		: null;

const lineUrl =
	member.line && member.line.trim() !== "-"
		? `https://line.me/ti/p/~${member.line}`
		: null;

const nicheTags = member.niche
	? member.niche
			.split(/[,/]/)
			.map((tag) => tag.trim())
			.filter(Boolean)
	: [];
---

<BaseLayout title={title} activeTab="/members">
	<main class={styles.container}>
		<!-- Back Button -->
		<nav class={styles.back_nav} aria-label="Breadcrumb">
			<a href="/members" class={styles.back_button}>
				<ArrowLeftIcon width={20} height={20} />
				<span>Back to members</span>
			</a>
		</nav>

		<!-- Main Member Profile Card Section -->
		<section class={styles.card_section}>
			<!-- Left: Avatar Photo -->
			<div class={styles.photo_box}>
				<img
					src={getMemberPhotoUrl(member)}
					alt={member.name}
					class={styles.photo}
					loading="eager"
					decoding="async"
				/>
			</div>

			<!-- Right: Member Details -->
			<div class={styles.details_box}>
				<!-- Social Media Links -->
				<div class={styles.social_row}>
					{instagramUrl && (
						<a
							href={instagramUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Instagram"
							class={styles.social_btn}
						>
							<InstagramIcon width={22} height={22} />
						</a>
					)}
					{linkedinUrl && (
						<a
							href={linkedinUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="LinkedIn"
							class={styles.social_btn}
						>
							<LinkedinIcon width={22} height={22} />
						</a>
					)}
					{githubUrl && (
						<a
							href={githubUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="GitHub"
							class={styles.social_btn}
						>
							<GithubIcon width={22} height={22} />
						</a>
					)}
					{lineUrl && (
						<a
							href={lineUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="LINE"
							class={styles.social_btn}
						>
							<LineIcon width={22} height={22} />
						</a>
					)}
				</div>

				<!-- Name & Major Badge -->
				<div class={styles.header_row}>
					<h1 class={styles.name}>{displayName}</h1>
					<span class={styles.major_pill}>{majorCode}</span>
				</div>

				<!-- Bio / Description -->
				<p class={styles.bio}>
					{member.deskripsi || "No description provided."}
				</p>

				<!-- Niche Domain Tags -->
				{nicheTags.length > 0 && (
					<div class={styles.niche_tags}>
						{nicheTags.map((tag) => (
							<span class={styles.tag_pill}>{tag}</span>
						))}
					</div>
				)}
			</div>
		</section>

		<!-- Bottom: See Similar People Section -->
		{similar.length > 0 && (
			<section class={styles.similar_section}>
				<div class={styles.similar_header}>
					<h2 class={styles.similar_title}>See similar people</h2>
					<div class={styles.scroll_controls}>
						<button
							type="button"
							id="scroll-left-btn"
							class={styles.scroll_btn}
							aria-label="Scroll left"
						>
							<ArrowLeftIcon width={20} height={20} />
						</button>
						<button
							type="button"
							id="scroll-right-btn"
							class={styles.scroll_btn}
							aria-label="Scroll right"
						>
							<ArrowRightIcon width={20} height={20} />
						</button>
					</div>
				</div>
				<div class={styles.similar_carousel} id="similar-carousel">
					{similar.map((s) => (
						<a
							href={`/members/${getMemberSlug(s)}`}
							class={styles.similar_card}
						>
							<div class={styles.similar_photo_box}>
								<img
									src={getMemberPhotoUrl(s)}
									alt={s.name}
									class={styles.similar_photo}
									loading="lazy"
									decoding="async"
								/>
							</div>
							<span class={styles.similar_name} title={s.name}>
								{s.nama_panggilan || s.name}
							</span>
							<span class={styles.similar_major}>
								{getMajorCode(s.major)}
							</span>
						</a>
					))}
				</div>
			</section>
		)}
	</main>
</BaseLayout>

<script>
	const carousel = document.getElementById("similar-carousel");
	const leftBtn = document.getElementById("scroll-left-btn");
	const rightBtn = document.getElementById("scroll-right-btn");

	leftBtn?.addEventListener("click", () => {
		carousel?.scrollBy({ left: -360, behavior: "smooth" });
	});

	rightBtn?.addEventListener("click", () => {
		carousel?.scrollBy({ left: 360, behavior: "smooth" });
	});
</script>
