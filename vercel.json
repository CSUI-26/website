{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "rewrites": [
    {
      "source": "/studio",
      "destination": "http://43.173.10.71/studio/"
    },
    {
      "source": "/studio/:path*",
      "destination": "http://43.173.10.71/studio/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://43.173.10.71/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "http://43.173.10.71/storage/:path*"
    }
  ]
}
