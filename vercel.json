
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "rewrites": [
    {
      "source": "/studio/",
      "destination": "https://zenith-stage.vicky.id/studio/"
    },
    {
      "source": "/studio/:path+",
      "destination": "https://zenith-stage.vicky.id/studio/:path+"
    },
    {
      "source": "/studio",
      "destination": "https://zenith.csui.dev/studio/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://zenith-stage.vicky.id/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://zenith-stage.vicky.id/storage/:path*"
    }
  ]
}
